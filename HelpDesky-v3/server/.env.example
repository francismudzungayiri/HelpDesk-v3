PORT=5001
JWT_SECRET=replace-with-strong-secret
DB_HOST=localhost
DB_PORT=5432
DB_NAME=helpdesky
DB_USERNAME=postgres
DB_PASSWORD=postgres
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the API (nginx on the same host = 1).
# Required for correct client IPs in rate limiting. Set to 0 when running direct.
TRUST_PROXY=1

# Optional one-time seed admin when running node init_db.js
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-now
SEED_ADMIN_NAME=System Admin
